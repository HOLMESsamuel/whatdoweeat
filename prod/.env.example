# Copy this file to prod/.env on the prod host and fill in real values.
# prod/.env is gitignored so the secrets never land in the repo.

# ---- Auth0 ----------------------------------------------------------
# AUTH0_AUDIENCE must match the API "Identifier" you create in the
# Auth0 dashboard under Applications -> APIs (e.g. https://api.whatdoweeat).
# Same value goes in frontend/.env.production as VITE_AUTH0_AUDIENCE.
AUTH0_DOMAIN=dev-ict4izvfqmjvanec.us.auth0.com
AUTH0_AUDIENCE=https://api.whatdoweeat

# ---- Dropbox app ----------------------------------------------------
# Create a "Scoped access" app at https://www.dropbox.com/developers/apps
# with Full Dropbox access and the permissions
#   - files.metadata.read
#   - files.content.read
# Add this redirect URI under "OAuth 2 -> Redirect URIs":
#   https://whatdoweeat.fr/api/dropbox/callback
# (and http://localhost:8000/dropbox/callback if you also want dev OAuth).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ---- Encryption key for stored Dropbox refresh tokens --------------
# Generate one with: python scripts/generate_enc_key.py
# If you ever rotate this, every user has to re-connect Dropbox.
DROPBOX_TOKEN_ENC_KEY=

# ---- Public URLs ----------------------------------------------------
# Used to build the Dropbox OAuth redirect URI and to redirect the
# browser back to the frontend after a successful connect.
BACKEND_PUBLIC_URL=https://whatdoweeat.fr/api
FRONTEND_PUBLIC_URL=https://whatdoweeat.fr
