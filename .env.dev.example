# Copy this file to .env.dev (gitignored) and fill in real values.
# start_dev.sh sources it and forwards everything to the backend uvicorn
# tab. Don't commit .env.dev — the example here is enough for the repo.
#
# Required for the per-user Dropbox flow to work locally. If you only
# want to use the single-tenant fallback (`/recipes` endpoint reading a
# local folder), you can leave the Dropbox vars empty.

# ---- Auth0 ----------------------------------------------------------
AUTH0_DOMAIN=dev-ict4izvfqmjvanec.us.auth0.com
AUTH0_AUDIENCE=https://api.whatdoweeat

# ---- Dropbox app (shared OAuth bridge) ------------------------------
# From your Dropbox app's Settings page. Make sure
#   http://localhost:8000/dropbox/callback
# is registered under "OAuth 2 → Redirect URIs" on the same app.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ---- Symmetric encryption key for stored Dropbox refresh tokens -----
# Generate with:
#   cd backend && source .venv/bin/activate
#   python ../scripts/generate_enc_key.py
# Same key encrypts/decrypts every user's tokens. Don't lose it.
DROPBOX_TOKEN_ENC_KEY=

# ---- Public URLs the OAuth flow redirects to ------------------------
# In dev, the backend is reachable at localhost:8000 directly because
# we don't put a reverse proxy in front of it the way prod does.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
